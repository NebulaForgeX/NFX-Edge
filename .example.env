# NFX-Edge Docker Compose Environment Variables
# sites-base + console. Reverse proxy: docker-compose.traefik.yml (`task traefik`).
# Certs: ./websites/<site>/ (sites-base ACME / export). Traefik does not issue certs.

TRAEFIK_API_HOST=edge-api.example.com
TRAEFIK_CONSOLE_HOST=edge.example.com

HTTP_PORT=8080
CONSOLE_PORT=80
VITE_PORT=5175
VITE_API_URL=/nfx-edge
VITE_BASE=/console/nfx-edge/
VITE_IDENTITY_API_URL=/nfx-identity

# Identity auth gRPC (NFX-Identity)
# 容器内 GRPC_PORT_*（50071+）；主机 GRPC_EXT_*。compose: "${GRPC_EXT_PORT_*}:${GRPC_PORT_*}"
GRPC_PORT_AUTH=50071
GRPC_PORT_SITES=50072
GRPC_EXT_PORT_SITES=10219
GRPC_HOST_AUTH=NFX-Identity-Auth-Base-Dev

API_GATEWAY_PREFIX=/nfx-edge
API_PREFIX_PATH_SITES=/edge

POSTGRESQL_HOST=192.168.1.64
POSTGRESQL_PORT=10104
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your-postgresql-password-here
POSTGRESQL_NAME_DEV=nfxedge_dev
POSTGRESQL_NAME_PROD=nfxedge
POSTGRESQL_NAME_SHADOW=nfxedge_diff
ATLAS_POSTGRES_HOST=192.168.1.64
ATLAS_POSTGRES_PORT=10104
POSTGRES_SSLMODE=disable
POSTGRES_CONTAINER_NAME=NFX-Stack-PostgreSQL

REDIS_HOST=192.168.1.64
REDIS_PORT=10106
REDIS_PASSWORD=your-redis-password-here

# Compose: kafka:9092 / otel-collector:4317. Host go run: 192.168.1.64:10108 / 10116
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_BROKERS=kafka:9092

OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317

# Must match NFX-Identity TOKEN_SECRET_KEY / TOKEN_ISSUER
TOKEN_SECRET_KEY=your-secret-key-here-change-in-production
TOKEN_ISSUER=nfxidentity
TOKEN_ACCESS_TTL=24h
TOKEN_REFRESH_TTL=168h
TOKEN_ALGORITHM=HS256
