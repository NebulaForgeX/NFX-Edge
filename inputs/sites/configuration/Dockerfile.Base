# Base 服务专用：docker-compose.yml 用 target: secure；docker-compose.dev.yml 用 target: dev

FROM golang:1.26.0-alpine AS base-builder
WORKDIR /src
RUN apk add --no-cache --no-scripts git ca-certificates tzdata
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.google.cn
COPY go.mod go.sum ./
RUN go mod download

FROM base-builder AS secure-build
COPY . ./
ARG APP_VERSION=dev
ENV CGO_ENABLED=0 GOOS=linux
RUN --mount=type=cache,target=/go/pkg/mod \
  --mount=type=cache,target=/root/.cache/go-build \
  go build -trimpath -ldflags="-s -w -X main.version=${APP_VERSION}" \
  -o /out/sites-base-service ./inputs/sites/base

FROM alpine:latest AS alpine-runtime
# certbot: Let's Encrypt HTTP-01 (webroot). openssl: existingPEM validity check.
RUN apk add --no-cache --no-scripts ca-certificates tzdata certbot openssl && update-ca-certificates

FROM alpine-runtime AS secure
WORKDIR /app
COPY --from=secure-build /out/sites-base-service /app/sites-base-service
COPY inputs/sites/configuration/secure.toml /app/config.toml
ENV APP_ENV=secure
ENV CONFIG_FILE=/app/config.toml
EXPOSE 8080
ENTRYPOINT ["/app/sites-base-service"]
CMD ["-env", "secure"]

FROM base-builder AS dev
WORKDIR /app
ENV PATH="/go/bin:$PATH"
RUN apk add --no-cache --no-scripts certbot openssl
RUN go install github.com/air-verse/air@v1.61.7
COPY . ./
CMD ["air", "-c", "inputs/sites/base/.air.toml"]
